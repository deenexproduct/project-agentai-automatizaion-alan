# Server Environment Variables
PORT=3000
# DB de la app (el server lee MONGODB_URI y, como fallback, MONGO_URI).
# Los scripts (seed/admin/tests) leen MONGODB_URI. NUNCA hardcodear credenciales en el código.
MONGODB_URI=mongodb://localhost:27017/voicecommand
MONGO_URI=mongodb://localhost:27017/voicecommand

# Token de auth para scripts de prueba (test-flow.ts). Generá uno desde la API; no lo commitees.
API_TOKEN=

# LLM Provider: set GROQ_API_KEY for cloud, leave empty for local Ollama
GROQ_API_KEY=

# Ollama (only needed if no GROQ_API_KEY)
OLLAMA_URL=http://localhost:11434

# LinkedIn Session Encryption (REQUIRED for encrypted cookie storage)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes for AES-256-GCM)
LINKEDIN_ENCRYPTION_KEY=

# LinkedIn Workspace ID (optional, defaults to 'default' for single-user setups)
LINKEDIN_WORKSPACE_ID=default

# Docker/Production — auto-set by Railway
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# NODE_ENV=production

# SerpAPI — web search for enrichment (get key at serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Dominio público del front. De acá cuelga el link que se le manda al partner
# (https://<FRONTEND_URL>/partners/<token>), así que en producción es
# OBLIGATORIA: sin ella el link saldría apuntando a localhost y no le abriría a
# nadie. El endpoint POST /api/partners/:id/access-link falla si no está.
FRONTEND_URL=https://tu-dominio.com
